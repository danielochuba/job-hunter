# Local mode: true = no sign-in, Supabase never contacted (run the API with LOCAL_MODE=true).
NEXT_PUBLIC_AUTH_DISABLED=false
# Supabase (Project Settings -> API). The anon key is only used to sign in.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# FastAPI backend (job-hunter-api)
NEXT_PUBLIC_API_URL=http://localhost:8000
